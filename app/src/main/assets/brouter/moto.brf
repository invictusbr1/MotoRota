#
# MotoRota - perfil de moto com 3 modos
#
#   modo = 0  SEGURA      : fica nas vias principais; areas de risco sao bloqueadas (feito no app via nogos)
#   modo = 1  DESEMPENHO  : prefere rodovia / pista livre, aceita rodar mais km, desvia de cidades
#   modo = 2  RAPIDA      : menor tempo
#
# Em todos os modos: estrada de terra / sem pavimento so entra se nao houver alternativa.
#
# Baseado no perfil car-vario do BRouter (MIT).
#
---model:btools.router.KinematicModel

---context:global

assign validForCars        = true

assign modo                = 2      # %modo% | 0=segura 1=desempenho 2=rapida | number
assign avoid_toll          = false  # %avoid_toll% | Evitar pedagio | boolean

assign is_segura      = equal modo 0
assign is_desempenho  = equal modo 1
assign is_rapida      = equal modo 2

# Modelo cinematico de uma moto media (~300 kg com piloto)
assign vmax             = 110
assign recup_efficiency = 0
assign totalweight      = 300
assign f_roll           = 45
assign f_air            = 0.3
assign f_recup          = 400
assign p_standby        = 0

# instrucoes de curva
assign turnInstructionMode          = 9
assign turnInstructionCatchingRange = 40
assign turnInstructionRoundabouts   = true

assign pass1coefficient    = 1.3
# pula a 2a passada exata (muito lenta no celular); a 1a ja da uma rota muito boa
assign pass2coefficient    = -1


---context:way

assign classifier_none        = 1
assign classifier_ferry       = 2

assign is_avoided_toll_road and avoid_toll toll=yes

assign isresidentialorliving = or highway=residential|living_street living_street=yes

assign caraccess
       switch motorcar=
              switch motor_vehicle=
                     switch vehicle=
                            switch access=
                                   switch highway=motorway|motorway_link       1
                                   switch highway=trunk|trunk_link             1
                                   switch highway=primary|primary_link         1
                                   switch highway=secondary|secondary_link     1
                                   switch highway=tertiary|tertiary_link       1
                                   switch highway=unclassified                 1
                                   switch highway=track                        1
                                   switch highway=road                         1
                                   switch route=ferry                          1
                                   switch isresidentialorliving                1
                                   switch highway=service                      1
                                   0
                                   access=yes|permissive|designated|destination
                            vehicle=yes|designated|destination
                     motor_vehicle=yes|permissive|designated|destination
              motorcar=yes|permissive|designated|destination

assign caraccess_destination
       switch motorcar=
              switch motor_vehicle=
                     switch vehicle=
                            access=destination
                            vehicle=destination
                     motor_vehicle=destination
              motorcar=destination

assign initialclassifier =
     if route=ferry then classifier_ferry
     else classifier_none

assign initialcost =
     if      ( and highway= not route=ferry ) then 10000
     else if ( equal initialclassifier classifier_ferry ) then 10000
     else 0

assign accessspeedlimit = if caraccess then 999 else 0

assign isbadoneway = if reversedirection=yes then ( if oneway= then junction=roundabout else oneway=yes|true|1 ) else oneway=-1
assign onewayspeedlimit = if isbadoneway then 0 else 999

assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link

#
# Pavimento
#
assign is_unpaved =
  if surface=unpaved|gravel|ground|dirt|grass|compacted|sand|fine_gravel|earth|mud|clay|pebblestone|rock|stone|wood then true
  else if surface= then
    ( if highway=track then ( not tracktype=grade1 )
      else tracktype=grade2|grade3|grade4|grade5 )
  else false

assign is_bad_paving = surface=cobblestone|sett|paving_stones|grass_paver

assign maxspeed_surface =
  switch is_unpaved
    ( switch surface=compacted|fine_gravel 45 30 )
  switch is_bad_paving 35
  999

assign maxspeed_implicit =
  switch highway=motorway                  999
  switch highway=motorway_link             80
  switch highway=trunk                     110
  switch highway=trunk_link                70
  switch highway=primary|primary_link      90
  switch highway=secondary|secondary_link   80
  switch highway=tertiary|tertiary_link     60
  switch highway=unclassified               50
  switch route=ferry                        10
  switch isresidentialorliving              30
  switch highway=service                    25
  switch highway=track|road                 30
  0

assign maxspeed_explicit =
  switch maxspeed=30 30
  switch maxspeed=40 40
  switch maxspeed=50 50
  switch maxspeed=60 60
  switch maxspeed=70 70
  switch maxspeed=80 80
  switch maxspeed=90 90
  switch maxspeed=100 100
  switch maxspeed=110 110
  switch maxspeed=120 120
  switch maxspeed=20 20
  switch maxspeed=10 10
  999

assign maxspeed =
  min onewayspeedlimit
  min accessspeedlimit
  min maxspeed_explicit
  min maxspeed_implicit
      maxspeed_surface

#
# Penalidades (somadas ao custo por metro; 1.0 = dobra o custo de rodar no limite)
#

# terra: so se nao houver alternativa
assign unpaved_penalty =
  switch is_unpaved ( switch is_desempenho 10 7 )
  switch is_bad_paving ( switch is_desempenho 1.5 0.6 )
  0

# tipo de via
assign road_penalty =
  switch is_desempenho
    ( switch highway=motorway|motorway_link|trunk|trunk_link 0
      switch highway=primary|primary_link 0.15
      switch highway=secondary|secondary_link 0.6
      switch highway=tertiary|tertiary_link 1.0
      switch highway=unclassified 1.5
      switch isresidentialorliving 2.2
      switch highway=service 2.5
      3 )
  switch is_segura
    ( switch highway=motorway|motorway_link|trunk|trunk_link|primary|primary_link 0
      switch highway=secondary|secondary_link 0.1
      switch highway=tertiary|tertiary_link 0.25
      switch highway=unclassified 0.5
      switch isresidentialorliving 0.8
      switch highway=service 1.0
      1.5 )
  ( switch isresidentialorliving 0.15
    switch highway=service 0.3
    0 )

# desempenho: contornar cidades (pista livre)
assign town_penalty =
  switch is_desempenho
    ( switch estimated_town_class=  0
      switch estimated_town_class=1  0.2
      switch estimated_town_class=2  0.4
      switch estimated_town_class=3  0.6
      switch estimated_town_class=4  0.8
      switch estimated_town_class=5  1.0
      switch estimated_town_class=6  1.2 0 )
  0

assign costfactor =
  if ( equal maxspeed 0 ) then 10000
  else if is_avoided_toll_road then 10000
  else min 9999
  add unpaved_penalty
  add road_penalty
      town_penalty

assign minspeed =
    switch highway=motorway|trunk  70 0

assign priorityclassifier =

  if      ( highway=motorway                  ) then  30
  else if ( highway=motorway_link             ) then  29
  else if ( highway=trunk                     ) then  28
  else if ( highway=trunk_link                ) then  27
  else if ( highway=primary                   ) then  26
  else if ( highway=primary_link              ) then  25
  else if ( highway=secondary                 ) then  24
  else if ( highway=secondary_link            ) then  23
  else if ( highway=tertiary                  ) then  22
  else if ( highway=tertiary_link             ) then  21
  else if ( highway=unclassified              ) then  20
  else if ( isresidentialorliving             ) then  6
  else if ( highway=service                   ) then  6
  else if ( highway=track                     ) then if tracktype=grade1 then 4 else 2
  else if ( highway=bridleway|road            ) then  2
  else 0

assign isgoodoneway = if reversedirection=yes then oneway=-1
                      else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout = junction=roundabout
assign isgoodforcars = if greater priorityclassifier 6 then true
                  else if or isresidentialorliving highway=service then true
                  else if ( and highway=track tracktype=grade1 ) then true
                  else false

assign classifiermask add          isbadoneway
                      add multiply isgoodoneway   2
                      add multiply isroundabout   4
                      add multiply islinktype     8
                      add multiply isgoodforcars 16
                      add multiply isresidentialorliving 32
                          multiply caraccess_destination 64

---context:node

assign caraccess
       switch motorcar=
              switch motor_vehicle=
                     switch vehicle=
                            switch access=
                                   not barrier=gate|bollard|lift_gate|cycle_barrier
                                   access=yes|permissive|designated|destination
                            vehicle=yes|permissive|designated|destination
                     motor_vehicle=yes|permissive|designated|destination
              motorcar=yes|permissive|designated|destination

assign initialcost =
       switch and avoid_toll barrier=toll_booth 1000000
       switch caraccess
              0
              1000000

assign maxspeed =

       if or crossing=traffic_signals highway=traffic_signals
       then
         switch greater way:priorityclassifier 24 5
         switch greater way:priorityclassifier 22 3
         switch greater way:priorityclassifier 20 1
         0
       else if railway=level_crossing then 0
       else 999
